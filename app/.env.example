# ─── Arabic Name Image Generator — Environment Variables ─────────────────────
#
# Copy this file to .env.local and fill in values before running locally.
# Never commit .env.local to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string (required for analytics / tracking features).
# Format: postgres://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgres://postgres:password@localhost:5432/arabic_image_gen
# For local/CI Postgres without TLS, disable SSL explicitly.
# Use `require` (or omit this) for managed production databases with TLS.
# PGSSLMODE=disable

# ── Analytics / Stats API ─────────────────────────────────────────────────────
# Secret bearer token for GET /api/stats.  Must be at least 32 characters.
# Generate a strong value with: openssl rand -hex 32
STATS_SECRET=change-me-to-a-strong-random-secret-at-least-32-chars

# ── Admin dashboard login ─────────────────────────────────────────────────────
# Secret used to sign the admin session cookie (HMAC-SHA256).
# Must be at least 32 characters in production.
# Generate: openssl rand -hex 32
ADMIN_SESSION_SECRET=change-me-to-a-strong-32-char-secret

# Admin username:password:role entries (comma-separated).
# Generate entries with: npx tsx scripts/create-admin-password.ts <user> <pass> <role>
# Format: username:scrypt:<N>:<r>:<p>:<saltHex>:<hashHex>:role
# Valid roles: viewer, analyst, operator, admin
# Example (generate the hash values with the script above):
# ADMIN_CREDENTIALS=alice:scrypt:16384:8:1:<saltHex>:<hashHex>:admin
ADMIN_CREDENTIALS=

# Admin API bearer tokens (for programmatic/script access — optional).
# Browser-based access uses the login form above instead.
# Format: role:token pairs separated by commas.
# Valid roles: viewer, analyst, operator, admin
# Example:
# ADMIN_API_KEYS=viewer:viewer-token-32chars-min,operator:operator-token-32chars-min,admin:admin-token-32chars-min
ADMIN_API_KEYS=
# Optional: failed-auth throttling for admin APIs (all /api/admin/* except login).
# Counts failed authentication attempts (wrong token/cookie) per IP.
# Successful authentications reset the counter.
# ADMIN_AUTH_MAX_ATTEMPTS=30   # default: 30 failed attempts before 429
# ADMIN_AUTH_WINDOW_MS=60000   # default: 60-second sliding window

# ── Rate limiter (optional overrides — defaults shown) ────────────────────────
# Controls POST /api/admin/auth/login AND POST /api/generate (shared limiter).
# RATE_LIMIT_MAX=10          # max requests per window per IP (default: 10)
# RATE_LIMIT_WINDOW_MS=60000 # sliding window in milliseconds (default: 60 000)
#
# ⚠️  Shared-NAT / VPN warning:
#     The limiter keys on the caller IP. If multiple operators share one egress
#     IP (office NAT, VPN), failed logins from any user on that IP count toward
#     the shared limit. Consider raising RATE_LIMIT_MAX (e.g., 50) for internal
#     deployments, or ensure your load balancer forwards X-Forwarded-For with the
#     real client IP. See .docs/admin_dashboard/T-ADM-012_Ops_Runbook.md §2.
#
# ⚠️  In-memory / single-process limitation:
#     Both rate limiters use in-process Maps. The counters reset on process
#     restart and are not shared across multiple app instances.
#     For multi-instance deployments replace checkRateLimit() in
#     lib/rate-limit.ts with a Redis-backed implementation (see T-ADM-012 §6).

# ── Node environment ──────────────────────────────────────────────────────────
# Set automatically by Next.js; override only if needed.
# NODE_ENV=production
