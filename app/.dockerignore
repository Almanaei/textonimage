# Dependencies — reinstalled inside the image
node_modules
npm-debug.log*

# Next.js build output — rebuilt inside the image
.next
out

# Environment secrets — must never enter the build context
.env
.env.local
.env.*.local

# Local dev only
.env.development
.env.test

# Version control
.git
.gitignore

# Editor / OS noise
.DS_Store
*.pem
.vscode
.idea

# Test artefacts
coverage
*.log
.tmp-*.log
tmp-*.log

# TypeScript incremental build info
*.tsbuildinfo
next-env.d.ts
